{
  "name": "tutorias-red-academica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names API,WEB --kill-others-on-fail \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test && node --test tests/firefox/*.test.js",
    "test:firefox": "node --test tests/firefox/*.test.js",
    "verify": "npm run build && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0"
  }
}
